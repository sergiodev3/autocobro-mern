# ===========================================
# CONFIGURACIÓN DEL FRONTEND - AUTOCOBRO APP
# ===========================================

# 🌐 API del Backend
# ------------------
# URL base del API backend (desarrollo)
VITE_API_URL=http://localhost:5000/api

# Para producción (cambiar cuando despliegues):
# VITE_API_URL=https://tu-api-produccion.herokuapp.com/api
# VITE_API_URL=https://tu-api-produccion.vercel.app/api

# 📱 Información de la Aplicación
# -------------------------------
VITE_APP_NAME=AutoCobro App
VITE_APP_VERSION=1.0.0
VITE_APP_DESCRIPTION=Sistema de Autocobro Inteligente

# ⚙️ Configuración de Desarrollo
# ------------------------------
# Habilitar modo debug (muestra logs extra en consola)
VITE_DEBUG_MODE=true

# Timeout para requests HTTP (en milisegundos)
VITE_API_TIMEOUT=5000

# 🎨 Configuración de Tema (OPCIONAL)
# -----------------------------------
VITE_PRIMARY_COLOR=#007bff
VITE_SECONDARY_COLOR=#6c757d

# 📷 Configuración de Cámara (POR IMPLEMENTAR)
# --------------------------------------------
# Para escaneo real de códigos de barras
VITE_CAMERA_ENABLED=false
VITE_BARCODE_FORMAT=CODE128

# 💳 Configuración de Pagos (POR IMPLEMENTAR)
# -------------------------------------------
# Para integración con pasarelas de pago
VITE_PAYMENT_GATEWAY=stripe
VITE_STRIPE_PUBLIC_KEY=pk_test_tu_clave_publica_de_stripe

# 🖨️ Configuración de Impresión (POR IMPLEMENTAR)
# ------------------------------------------------
VITE_PRINTER_ENABLED=false
VITE_RECEIPT_TEMPLATE=default

# 📝 INSTRUCCIONES DE USO:
# -----------------------
# 1. Copia este archivo como ".env" en la carpeta frontend
# 2. Reemplaza los valores de ejemplo con los reales
# 3. Las variables que empiezan con VITE_ están disponibles en el código
# 4. NUNCA subas el archivo .env con claves reales a git
# 5. En producción, configura estas variables en tu hosting (Vercel, Netlify, etc.)