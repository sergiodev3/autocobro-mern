# ===========================================
# CONFIGURACIÓN DEL BACKEND - AUTOCOBRO APP
# ===========================================

# 🗄️ Base de Datos MongoDB
# -------------------------
# Para desarrollo local:
MONGODB_URI=mongodb://localhost:27017/autocobro-db

# Para MongoDB Atlas (producción):
# MONGODB_URI=mongodb+srv://usuario:contraseña@cluster.mongodb.net/autocobro-db?retryWrites=true&w=majority

# 🚀 Configuración del Servidor
# -----------------------------
PORT=5000
NODE_ENV=development

# 🔐 Seguridad (POR IMPLEMENTAR)
# ------------------------------
# Secreto para JWT (cambiar por uno seguro)
JWT_SECRET=tu_jwt_secret_muy_seguro_cambiar_en_produccion
JWT_EXPIRES_IN=7d

# Configuración para hash de contraseñas
BCRYPT_ROUNDS=12

# 📧 Email (OPCIONAL - POR IMPLEMENTAR)
# ------------------------------------
# Para notificaciones por email
EMAIL_USER=tu_email@gmail.com
EMAIL_PASS=tu_app_password_de_gmail
EMAIL_SERVICE=gmail

# 🌐 CORS (Configuración automática)
# ----------------------------------
# El frontend se ejecuta en:
FRONTEND_URL=http://localhost:5173

# 📝 INSTRUCCIONES DE USO:
# -----------------------
# 1. Copia este archivo como ".env" en la carpeta backend
# 2. Reemplaza los valores de ejemplo con los reales
# 3. NUNCA subas el archivo .env a git (ya está en .gitignore)
# 4. En producción, configura estas variables en tu hosting